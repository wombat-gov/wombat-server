# wombat-server — local development environment
# Copy to .env and source before running: `export $(grep -v '^#' .env | xargs)`
# For Docker Compose use the root .env.example instead (docker compose reads it automatically).

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL async DSN — consumed by SQLAlchemy (engine) and Alembic (migrations).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://wombat:changeme@localhost:5432/wombat

# ── Server ────────────────────────────────────────────────────────────────────
# Environment label shown in logs and /health response.
WOMBAT_ENV=local

# Comma-separated CORS origins allowed to call the API.
# Include the Vite dev server (5173) when developing the dashboard locally.
# SSO login callbacks only redirect to origins listed here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Browser session / network hardening ──────────────────────────────────────
# HttpOnly cookie sessions (dashboard) + Bearer tokens (CLI/CI).
WOMBAT_COOKIE_AUTH=true
# Keep false for http://localhost; non-local environments must set true.
WOMBAT_COOKIE_SECURE=false
WOMBAT_COOKIE_SAMESITE=lax
WOMBAT_CSRF_ENABLED=true
# Required outside local (Host-header allowlist).
WOMBAT_ALLOWED_HOSTS=localhost,127.0.0.1
# One reverse proxy adds one trusted hop; 0 = direct.
WOMBAT_TRUSTED_PROXY_COUNT=0
# Required outside local. Used for QR codes/absolute links.
WOMBAT_PUBLIC_URL=http://localhost:3000

# ── Login protection ─────────────────────────────────────────────────────────
WOMBAT_LOGIN_MAX_FAILURES=5
WOMBAT_LOGIN_LOCK_MINUTES=15
WOMBAT_LOGIN_IP_LIMIT=20
WOMBAT_LOGIN_IP_WINDOW_SECONDS=60
# Redis URL for multi-replica throttling; empty = in-memory.
WOMBAT_REDIS_URL=

# ── Password policy ──────────────────────────────────────────────────────────
WOMBAT_PASSWORD_MIN_LENGTH=12
WOMBAT_ADMIN_PASSWORD_MIN_LENGTH=16
# Test/automation only: false skips the bootstrap password-rotation screen.
WOMBAT_FORCE_PASSWORD_ROTATION=true

# ── Sessions ─────────────────────────────────────────────────────────────────
WOMBAT_SESSION_IDLE_MINUTES=480
WOMBAT_SESSION_ABSOLUTE_DAYS=7
WOMBAT_SESSION_MAX=10

# ── MFA ──────────────────────────────────────────────────────────────────────
WOMBAT_MFA_ENABLED=true
WOMBAT_MFA_REQUIRED_ROLES=admin,ciso
WOMBAT_MFA_ISSUER=WOMBATpass
WOMBAT_MFA_TOKEN_MINUTES=5

# ── SCIM 2.0 ─────────────────────────────────────────────────────────────────
WOMBAT_SCIM_ENABLED=false
WOMBAT_SCIM_TOKEN=
WOMBAT_SCIM_MANDANT_SLUG=
WOMBAT_SCIM_DEFAULT_ROLE=engineer

# ── Observability ────────────────────────────────────────────────────────────
# json for production/log shipping; text for local development.
WOMBAT_LOG_FORMAT=text
WOMBAT_LOG_LEVEL=INFO
WOMBAT_METRICS_ENABLED=true
WOMBAT_OTEL_ENABLED=false
WOMBAT_OTEL_ENDPOINT=
WOMBAT_OTEL_SAMPLE_RATE=0.1
WOMBAT_SENTRY_DSN=
WOMBAT_SENTRY_ENVIRONMENT=

# ── JWT / at-rest encryption ─────────────────────────────────────────────────
# Required outside local. Generate: openssl rand -hex 48
WOMBAT_JWT_SECRET=
# Required outside local; must differ from WOMBAT_JWT_SECRET.
WOMBAT_ENCRYPTION_KEY=

# ── Authentication ────────────────────────────────────────────────────────────
# Pre-shared key for machine-to-machine ingest (X-Api-Key header).
# Empty = disabled.
WOMBAT_API_KEY=
# Multi-mandant mode only: slug of the mandate the legacy shared key is
# allowed to act as. Empty = the legacy key is rejected after activation.
WOMBAT_LEGACY_API_KEY_MANDANT_SLUG=

# ── Server-side scanning ──────────────────────────────────────────────────────
# POST /scan and /auto-fix resolve paths and confine them to this directory.
# When empty, the server's working directory is used. Set it to the workspace
# root you want to allow, e.g. /srv/iac or /Users/you/git.
WOMBAT_SCAN_BASE_DIR=
# Set to false to disable server-side scanning entirely.
WOMBAT_SCAN_ENABLED=true

# ── Architect Sandbox ─────────────────────────────────────────────────────────
# Path to Wombat control YAML files used by the /api/v1/sandbox endpoint.
# When running the server from wafpass-server/ alongside the monorepo:
WOMBAT_CONTROLS_DIR=../pass/controls

# ── Framework Update Checker ─────────────────────────────────────────────────
# Base path for Wombat framework repositories.
# When running locally from wafpass-server/, use:
WOMBAT_BASE_PATH=/Users/lewandos/git/waf++

# ── Validation Gateway Integration ────────────────────────────────────────────
# Path to the gateway-issued server sub-CA certificate. In local dev, register
# the server public key at the validation gateway and mount the issued cert here.
# Empty = fall back to the self-generated legacy server.crt in the keys dir.
WOMBAT_SERVER_SUBCA_CERT=

# Shared secret used by the validation gateway when calling the server's
# /api/v1/validations/internal/sign mirror endpoint. Must match the gateway's
# WOMBAT_SERVER_INTERNAL_API_KEY. Empty = internal signing callback is rejected.
WOMBAT_INTERNAL_API_KEY=
